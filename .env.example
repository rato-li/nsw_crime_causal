# ---------------------------------------------------------------------------
# Copy to .env and adjust. All variables use the NSWCAUSAL_ prefix.
# ---------------------------------------------------------------------------

# --- MSSQL / Data Vault (LAN server) ---------------------------------------
NSWCAUSAL_MSSQL_HOST=192.168.1.185
NSWCAUSAL_MSSQL_PORT=1433
NSWCAUSAL_MSSQL_DATABASE=DataVault
NSWCAUSAL_MSSQL_USER=ai
# Put the real password in .env (git-ignored); never commit real credentials.
NSWCAUSAL_MSSQL_PASSWORD=CHANGE_ME
NSWCAUSAL_MSSQL_DRIVER=ODBC Driver 18 for SQL Server
NSWCAUSAL_MSSQL_TRUST_CERT=true

# --- Local LLM served by Strata (OpenAI-compatible endpoint) ----------------
# Point at whatever host/port Strata exposes its OpenAI-compatible API on.
NSWCAUSAL_LLM_BASE_URL=http://127.0.0.1:8000/v1
NSWCAUSAL_LLM_MODEL=qwen3.8-flash-next-unsloth-ud-iq4_xs
NSWCAUSAL_LLM_API_KEY=local
NSWCAUSAL_LLM_TEMPERATURE=0.2
NSWCAUSAL_LLM_MAX_TOKENS=3000

# --- Pipeline knobs ----------------------------------------------------------
NSWCAUSAL_SEED=42
NSWCAUSAL_CORR_EDGE_THRESHOLD=0.35
NSWCAUSAL_GNN_LAYERS=2
NSWCAUSAL_GNN_HIDDEN=64
NSWCAUSAL_GNN_DIM=32
NSWCAUSAL_GNN_EPOCHS=300
NSWCAUSAL_PC_ALPHA=0.05
